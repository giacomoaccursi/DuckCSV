{
    "name": "duckcsv",
    "displayName": "DuckCSV",
    "description": "High-performance CSV/TSV/Parquet viewer powered by DuckDB — edit, query, filter, and profile your data directly in VS Code",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "publisher": "giacomoaccursi",
    "repository": {
        "type": "git",
        "url": "https://github.com/gaccursi/DuckCSV"
    },
    "engines": {
        "vscode": "^1.106.0"
    },
    "categories": [
        "Machine Learning",
        "Data Science",
        "AI",
        "Education",
        "Visualization",
        "Other"
    ],
    "keywords": [
        "csv",
        "tsv",
        "table",
        "viewer",
        "data"
    ],
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#4CAF50",
        "theme": "dark"
    },
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "duckcsv.preview",
                "title": "DuckCSV: Open Preview",
                "icon": "$(table)"
            },
            {
                "command": "duckcsv.workspace",
                "title": "DuckCSV: Open Workspace",
                "icon": "$(multiple-windows)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "duckcsv.preview",
                    "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .parquet || resourceLangId == csv",
                    "group": "navigation"
                }
            ],
            "editor/title/context": [
                {
                    "command": "duckcsv.preview",
                    "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .parquet || resourceLangId == csv",
                    "group": "1_open"
                }
            ],
            "explorer/context": [
                {
                    "command": "duckcsv.preview",
                    "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .parquet",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "duckcsv.preview",
                    "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .parquet || resourceLangId == csv",
                    "group": "1_open"
                }
            ],
            "commandPalette": [
                {
                    "command": "duckcsv.preview",
                    "when": "true"
                },
                {
                    "command": "duckcsv.workspace",
                    "when": "true"
                }
            ]
        },
        "keybindings": [
            {
                "command": "duckcsv.preview",
                "key": "cmd+k v",
                "mac": "cmd+k v",
                "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .parquet"
            }
        ],
        "languages": [
            {
                "id": "csv",
                "extensions": [
                    ".csv",
                    ".tsv"
                ],
                "aliases": [
                    "CSV",
                    "csv"
                ]
            }
        ],
        "configuration": {
            "title": "DuckCSV",
            "properties": {}
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run build:webview && webpack",
        "watch": "webpack --watch",
        "build:webview": "esbuild media/src/main.js --bundle --outfile=media/script.js --format=iife --target=es2020 && esbuild media/src/workspace-main.js --bundle --outfile=media/workspace.js --format=iife --target=es2020",
        "package": "npm run build:webview && webpack --mode production --devtool hidden-source-map",
        "lint": "eslint src",
        "test": "vitest run"
    },
    "dependencies": {
        "@duckdb/duckdb-wasm": "1.33.1-dev45.0"
    },
    "devDependencies": {
        "@types/jsdom": "28.0.3",
        "@types/node": "22.x",
        "@types/vscode": "^1.106.1",
        "copy-webpack-plugin": "^14.0.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.39.1",
        "jsdom": "28.1.0",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3",
        "vitest": "^4.1.6",
        "webpack": "^5.102.1",
        "webpack-cli": "^6.0.1"
    }
}
